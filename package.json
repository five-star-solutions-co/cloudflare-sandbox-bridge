{
  "name": "cloudflare-sandbox-bridge",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Cloudflare Worker that exposes the sandbox HTTP API via the @cloudflare/sandbox SDK",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "biome check --write",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "bun script/integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@cloudflare/sandbox": "*",
    "@cloudflare/vitest-pool-workers": "^0.16.17",
    "@cloudflare/workers-types": "^4.20251126.0",
    "@types/node": "^24.10.1",
    "hono": "^4.12.31",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.102.0"
  }
}
