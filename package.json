{
	"name": "cloudflare-sandbox-bridge",
	"version": "0.0.1",
	"private": true,
	"description": "Cloudflare Worker that exposes the sandbox HTTP API via the @cloudflare/sandbox SDK",
	"type": "module",
	"scripts": {
		"postinstall": "(bun run env:decrypt:development || true) && (bun run env:decrypt:production || true)",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --env-file .env.development",
		"start": "wrangler dev --env-file .env.development",
		"lint": "oxlint src",
		"lint:fix": "oxlint --fix src",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"typecheck": "oxlint --type-aware --type-check src/index.ts",
		"types": "wrangler types --env-file .env.example",
		"cf-typegen": "wrangler types --env-file .env.example",
		"test": "vitest run",
		"test:integration": "bun script/integration",
		"check": "bun run --parallel format:check lint typecheck && bun run test",
		"env:decrypt:development": "dotenvx decrypt -f .env.development.encrypted --stdout > .env.development",
		"env:decrypt:production": "dotenvx decrypt -f .env.production.encrypted --stdout > .env.production",
		"env:decrypt": "bun run env:decrypt:development && bun run env:decrypt:production",
		"env:encrypt:development": "dotenvx encrypt -f .env.development --stdout > .env.development.encrypted",
		"env:encrypt:production": "dotenvx encrypt -f .env.production --stdout > .env.production.encrypted",
		"env:encrypt": "bun run env:encrypt:development && bun run env:encrypt:production",
		"env:sync": "bun --no-env-file x @utilities-studio/sync-env cloudflare",
		"env:sync:development": "bun --no-env-file x @utilities-studio/sync-env cloudflare --env development",
		"env:sync:production": "bun --no-env-file x @utilities-studio/sync-env cloudflare --env production",
		"hooks:install": "lefthook install",
		"hooks:validate": "lefthook validate"
	},
	"devDependencies": {
		"@cloudflare/sandbox": "*",
		"@cloudflare/vitest-pool-workers": "0.16.20",
		"@cloudflare/workers-types": "4.20260702.1",
		"@dotenvx/dotenvx": "1.75.1",
		"@types/node": "24.13.3",
		"@utilities-studio/sync-env": "1.1.13",
		"hono": "4.13.2",
		"lefthook": "2.1.10",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "5.9.3",
		"vitest": "4.1.10",
		"wrangler": "4.123.0"
	},
	"overrides": {
		"@dotenvx/dotenvx": "1.75.1"
	},
	"engines": {
		"bun": ">=1.3.13",
		"node": ">=24"
	},
	"packageManager": "bun@1.3.14"
}
